{
  "name": "api",
  "version": "1.0.50",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun run check-types",
    "check-types": "tsc --noEmit",
    "lint": "eslint src prisma.config.ts && prettier --check src prisma.config.ts tsconfig.json package.json eslint.config.mjs",
    "format": "prettier --write src prisma.config.ts tsconfig.json package.json eslint.config.mjs",
    "auth:bootstrap": "bunx --bun auth@1.7.7 create-admin --config src/modules/auth/auth.ts --role admin --no-email-verified",
    "media:cleanup": "bun run src/scripts/media-cleanup.ts",
    "media:migrate-logos": "bun run src/scripts/migrate-organization-logos.ts",
    "media:backfill-consumers": "bun run src/scripts/backfill-consumer-media.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@better-auth/core": "1.7.7",
    "@elysia/openapi": "^1.4.16",
    "@elysiajs/cors": "^1.4.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sinclair/typebox": "^0.34.52",
    "better-auth": "1.7.7",
    "dotenv": "^18.0.7",
    "elysia": "1.4.30",
    "http-errors": "2.0.1",
    "read-excel-file": "^9.3.15",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/http-errors": "2",
    "bun-types": "1.4.2",
    "eslint": "10",
    "prettier": "3.9.6",
    "prisma": "7.10.0",
    "prismabox": "1.1.26",
    "typescript": "6.0.2",
    "typescript-eslint": "8"
  }
}
