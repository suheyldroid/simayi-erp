/// One persistent money configuration per organization. The canonical currency
/// is captured from the configured system default on the first explicit
/// financial action and never by a read; a later system-default change never
/// relabels recorded history.
model OrganizationFinance {
  id             Int          @id @default(autoincrement())
  uuid           String       @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @unique @map("organization_id")
  currencyCode   String       @db.VarChar(3) @map("currency_code")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@map("organization_finance")
}

/// One cash movement in the organization finance currency. A positive amount is
/// cash inflow and a negative amount is cash outflow; the balance is the exact
/// sum of posted rows, never a mutable balance field. Kinds: 20 income, 30
/// expense, 40 supplier payment, 50 sale receipt, 60 purchase, 90 reversal. Only
/// a purchase row carries a reservation lifecycle: `status` 10 is reserved on
/// hold, 20 posted and 30 cancelled, and every other kind stays at 20. A
/// reversal row carries the negated amount, the same source links and a unique
/// `reversalOfId`, so an original entry is reversed at most once and net sums
/// stay exact.
model MoneyMovement {
  id             Int          @id @default(autoincrement())
  uuid           String       @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id")
  entryKind      Int          @map("entry_kind")
  status         Int          @default(20)
  currencyCode   String       @db.VarChar(3) @map("currency_code")
  amount         Decimal      @db.Decimal(19, 6)
  occurredAt     DateTime     @map("occurred_at") @db.Date
  note           String       @default("") @db.VarChar(500)
  requestKey     String?      @map("request_key") @db.VarChar(100)
  reversalOfId   Int?         @unique @map("reversal_of_id")
  buildId        Int?         @map("build_id")
  supplierId     Int?         @map("supplier_id")
  /// The single purchase order this row reserves or posts. Unique per
  /// organization for the purchase kind, so one order has one lifecycle row.
  purchaseOrderId Int?        @map("purchase_order_id")
  /// True while the reservation cannot be summed exactly: no priced line yet,
  /// a missing or unknown price, or a line in another currency.
  pricingIncomplete Boolean   @default(false) @map("pricing_incomplete")
  /// Lines of the order that cannot contribute an exact amount to the hold.
  pricingIssueCount Int       @default(0) @map("pricing_issue_count")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById    String?      @map("created_by_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  build          Build?       @relation(fields: [buildId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  supplier       Supplier?    @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  purchaseOrder  PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reversalOf     MoneyMovement? @relation("MoneyMovementReversal", fields: [reversalOfId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reversal       MoneyMovement? @relation("MoneyMovementReversal")
  supplierEntry  SupplierLedgerEntry?
  createdBy      User?        @relation("MoneyMovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([organizationId, id])
  @@index([organizationId, occurredAt, id])
  @@index([organizationId, status])
  @@index([buildId])
  @@index([supplierId])
  @@index([purchaseOrderId])
  @@map("money_movement")
}

/// One posted supplier ledger entry in the organization finance currency.
/// Positive amounts increase what we owe the supplier (debt) and negative
/// amounts reduce it (credit / advance); the outstanding balance is the exact
/// sum of posted rows and may stay negative. Kinds: 20 purchase,
/// 30 payment, 90 reversal.
model SupplierLedgerEntry {
  id              Int          @id @default(autoincrement())
  uuid            String       @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String       @map("organization_id")
  supplierId      Int          @map("supplier_id")
  entryKind       Int          @map("entry_kind")
  currencyCode    String       @db.VarChar(3) @map("currency_code")
  amount          Decimal      @db.Decimal(19, 6)
  occurredAt      DateTime     @map("occurred_at") @db.Date
  note            String       @default("") @db.VarChar(500)
  requestKey      String?      @map("request_key") @db.VarChar(100)
  reversalOfId    Int?         @unique @map("reversal_of_id")
  purchaseOrderId Int?         @map("purchase_order_id")
  moneyMovementId Int?         @unique @map("money_movement_id")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById     String?      @map("created_by_id")
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  supplier        Supplier     @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  moneyMovement   MoneyMovement? @relation(fields: [moneyMovementId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reversalOf      SupplierLedgerEntry? @relation("SupplierLedgerEntryReversal", fields: [reversalOfId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reversal        SupplierLedgerEntry? @relation("SupplierLedgerEntryReversal")
  createdBy       User?        @relation("SupplierLedgerEntryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([organizationId, id])
  @@index([organizationId, supplierId, occurredAt, id])
  @@index([purchaseOrderId])
  @@map("supplier_ledger_entry")
}
