/// One stored binary object. The row is the complete index of what lives on
/// the private media root: `storageKey` is a server-generated relative path
/// (`<purpose>/<uuid>.<ext>`), never client text, and the public identity is
/// the UUID. No bytes, base64, or absolute path are stored here. Lifecycle
/// status: 10 temporary (uploader-owned, unclaimed, expires), 20 attached
/// (claimed and bound by the reference; `organizationId` is the owner while it
/// exists and becomes null when the organization is deleted, which deferred
/// cleanup then collects), 30 deleting (deferred cleanup claimed it; the row
/// survives until the file is gone so a failed filesystem delete can be
/// retried with `deleteAttempts` and `lastDeleteError`).
model MediaFile {
  id              Int           @id @default(autoincrement())
  uuid            String        @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storageKey      String        @unique @map("storage_key") @db.VarChar(160)
  originalName    String        @map("original_name") @db.VarChar(255)
  contentType     String        @map("content_type") @db.VarChar(80)
  byteSize        Int           @map("byte_size")
  purpose         String        @db.VarChar(32)
  status          Int           @default(10)
  organizationId  String?       @map("organization_id")
  uploaderId      String?       @map("uploader_id")
  /// Exact binding written on claim, for example `/media/<uuid>` for the
  /// organization logo.
  reference       String?       @db.VarChar(160)
  expiresAt       DateTime?     @map("expires_at") @db.Timestamptz(6)
  claimedAt       DateTime?     @map("claimed_at") @db.Timestamptz(6)
  deleteStartedAt DateTime?     @map("delete_started_at") @db.Timestamptz(6)
  deleteAttempts  Int           @default(0) @map("delete_attempts")
  lastDeleteError String?       @map("last_delete_error") @db.VarChar(500)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  uploader        User?         @relation("MediaFileUploader", fields: [uploaderId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([status, expiresAt])
  @@index([status, deleteStartedAt])
  @@index([organizationId, status])
  @@index([uploaderId, status])
  @@unique([organizationId, purpose, reference])
  @@map("media_file")
}

