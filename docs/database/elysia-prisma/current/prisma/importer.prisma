/// Database model representing a data import session.
/// Source: src/backend/InvenTree/importer/models.py:31
model DataImportSession {
  /// DEFAULT_AUTO_FIELD = django.db.models.AutoField
  id Int @id @default(autoincrement())
  timestamp DateTime @db.Timestamptz(6)
  data_file String @db.VarChar(100)
  columns Json? @db.JsonB
  model_type String @db.VarChar(100)
  /// Source application default: DataImportStatusCode.INITIAL.value
  status Int
  user_id Int?
  field_defaults Json? @db.JsonB
  field_overrides Json? @db.JsonB
  field_filters Json? @db.JsonB
  /// Source application default: False
  update_records Boolean
  completed_row_count_history Int?
  row_count_history Int?
  /// Django on_delete: SET_NULL; see deletion policy in README.
  user User? @relation("DataImportSession_user", fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fromDataImportColumnMapSession DataImportColumnMap[] @relation("DataImportColumnMap_session")
  fromDataImportRowSession DataImportRow[] @relation("DataImportRow_session")
  @@index([user_id])
  @@map("importer_dataimportsession")
}

/// Database model representing a mapping between a file column and serializer field.
/// Source: src/backend/InvenTree/importer/models.py:501
model DataImportColumnMap {
  /// DEFAULT_AUTO_FIELD = django.db.models.AutoField
  id Int @id @default(autoincrement())
  session_id Int
  field String @db.VarChar(100)
  column String @db.VarChar(100)
  lookup_field String? @db.VarChar(100)
  /// Django on_delete: CASCADE; see deletion policy in README.
  session DataImportSession @relation("DataImportColumnMap_session", fields: [session_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@index([session_id])
  @@map("importer_dataimportcolumnmap")
}

/// Database model representing a single row in a data import session.
/// Source: src/backend/InvenTree/importer/models.py:640
model DataImportRow {
  /// DEFAULT_AUTO_FIELD = django.db.models.AutoField
  id Int @id @default(autoincrement())
  session_id Int
  /// Source application default: 0
  row_index Int
  row_data Json? @db.JsonB
  data Json? @db.JsonB
  errors Json? @db.JsonB
  /// Source application default: False
  valid Boolean
  /// Source application default: False
  complete Boolean
  /// Django on_delete: CASCADE; see deletion policy in README.
  session DataImportSession @relation("DataImportRow_session", fields: [session_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@index([session_id])
  @@map("importer_dataimportrow")
}
