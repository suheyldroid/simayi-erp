/// A Company object represents an external company.
/// Source: src/backend/InvenTree/company/models.py:78
model Company {
  /// DEFAULT_AUTO_FIELD = django.db.models.AutoField
  id Int @id @default(autoincrement())
  metadata Json? @db.JsonB
  image String? @db.VarChar(100)
  name String @db.VarChar(100)
  description String @db.VarChar(500)
  website String @db.VarChar(2000)
  phone String @db.VarChar(50)
  email String? @db.VarChar(254)
  contact String @db.VarChar(100)
  link String @db.VarChar(2000)
  /// Source application default: True
  active Boolean
  /// Source application default: False
  is_customer Boolean
  /// Source application default: True
  is_supplier Boolean
  /// Source application default: False
  is_manufacturer Boolean
  /// Source application default: currency_code_default
  currency String @db.VarChar(3)
  tax_id String @db.VarChar(50)
  fromContactCompany Contact[] @relation("Contact_company")
  fromAddressCompany Address[] @relation("Address_company")
  fromManufacturerPartManufacturer ManufacturerPart[] @relation("ManufacturerPart_manufacturer")
  fromSupplierPartSupplier SupplierPart[] @relation("SupplierPart_supplier")
  fromPurchaseOrderSupplier PurchaseOrder[] @relation("PurchaseOrder_supplier")
  fromSalesOrderCustomer SalesOrder[] @relation("SalesOrder_customer")
  fromReturnOrderCustomer ReturnOrder[] @relation("ReturnOrder_customer")
  fromStockItemCustomer StockItem[] @relation("StockItem_customer")
  @@unique([name, email])
  @@map("company_company")
}

/// A Contact represents a person who works at a particular company. A Company may have zero or more associated Contact objects.
/// Source: src/backend/InvenTree/company/models.py:299
model Contact {
  /// DEFAULT_AUTO_FIELD = django.db.models.AutoField
  id Int @id @default(autoincrement())
  metadata Json? @db.JsonB
  company_id Int
  name String @db.VarChar(100)
  phone String @db.VarChar(100)
  email String @db.VarChar(254)
  role String @db.VarChar(100)
  /// Django on_delete: CASCADE; see deletion policy in README.
  company Company @relation("Contact_company", fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fromPurchaseOrderContact PurchaseOrder[] @relation("PurchaseOrder_contact")
  fromSalesOrderContact SalesOrder[] @relation("SalesOrder_contact")
  fromReturnOrderContact ReturnOrder[] @relation("ReturnOrder_contact")
  fromTransferOrderContact TransferOrder[] @relation("TransferOrder_contact")
  @@index([company_id])
  @@map("company_contact")
}

/// An address represents a physical location where the company is located. It is possible for a company to have multiple locations.
/// Source: src/backend/InvenTree/company/models.py:335
model Address {
  /// DEFAULT_AUTO_FIELD = django.db.models.AutoField
  id Int @id @default(autoincrement())
  company_id Int
  title String @db.VarChar(100)
  /// Source application default: False
  primary Boolean
  line1 String @db.VarChar(50)
  line2 String @db.VarChar(50)
  postal_code String @db.VarChar(10)
  postal_city String @db.VarChar(50)
  province String @db.VarChar(50)
  country String @db.VarChar(50)
  shipping_notes String @db.VarChar(100)
  internal_shipping_notes String @db.VarChar(100)
  link String @db.VarChar(2000)
  /// Django on_delete: CASCADE; see deletion policy in README.
  company Company @relation("Address_company", fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fromPurchaseOrderAddress PurchaseOrder[] @relation("PurchaseOrder_address")
  fromSalesOrderAddress SalesOrder[] @relation("SalesOrder_address")
  fromSalesOrderShipmentShipment_address SalesOrderShipment[] @relation("SalesOrderShipment_shipment_address")
  fromReturnOrderAddress ReturnOrder[] @relation("ReturnOrder_address")
  fromTransferOrderAddress TransferOrder[] @relation("TransferOrder_address")
  @@index([company_id])
  @@map("company_address")
}

/// Represents a unique part as provided by a Manufacturer Each ManufacturerPart is identified by a MPN (Manufacturer Part Number) Each ManufacturerPart is also linked to a Part object. A Part may be available from multiple manufacturers.
/// Source: src/backend/InvenTree/company/models.py:489
model ManufacturerPart {
  /// DEFAULT_AUTO_FIELD = django.db.models.AutoField
  id Int @id @default(autoincrement())
  metadata Json? @db.JsonB
  barcode_data String @db.VarChar(500)
  barcode_hash String @db.VarChar(128)
  part_id Int
  manufacturer_id Int?
  MPN String? @db.VarChar(100)
  link String? @db.VarChar(2000)
  description String? @db.VarChar(250)
  /// Django on_delete: CASCADE; see deletion policy in README.
  part Part @relation("ManufacturerPart_part", fields: [part_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Django on_delete: CASCADE; see deletion policy in README.
  manufacturer Company? @relation("ManufacturerPart_manufacturer", fields: [manufacturer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fromSupplierPartManufacturer_part SupplierPart[] @relation("SupplierPart_manufacturer_part")
  @@unique([part_id, manufacturer_id, MPN])
  @@index([manufacturer_id])
  @@index([part_id])
  @@map("company_manufacturerpart")
}

/// Represents a unique part as provided by a Supplier Each SupplierPart is identified by a SKU (Supplier Part Number) Each SupplierPart is also linked to a Part or ManufacturerPart object. A Part may be available from multiple suppliers.
/// Source: src/backend/InvenTree/company/models.py:604
model SupplierPart {
  /// DEFAULT_AUTO_FIELD = django.db.models.AutoField
  id Int @id @default(autoincrement())
  updated DateTime? @db.Timestamptz(6)
  barcode_data String @db.VarChar(500)
  barcode_hash String @db.VarChar(128)
  metadata Json? @db.JsonB
  part_id Int
  supplier_id Int
  SKU String @db.VarChar(100)
  /// Source application default: True
  active Boolean
  /// Source application default: False
  primary Boolean
  manufacturer_part_id Int?
  link String? @db.VarChar(2000)
  description String? @db.VarChar(250)
  note String? @db.VarChar(100)
  /// Source application default: 0
  base_cost Decimal @db.Decimal(10, 3)
  packaging String? @db.VarChar(50)
  pack_quantity String @db.VarChar(25)
  /// Source application default: 1
  pack_quantity_native Decimal? @db.Decimal(20, 10)
  /// Source application default: 1
  multiple Int
  /// Source application default: 0
  available Decimal @db.Decimal(10, 3)
  availability_updated DateTime? @db.Timestamptz(6)
  /// Django on_delete: CASCADE; see deletion policy in README.
  part Part @relation("SupplierPart_part", fields: [part_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Django on_delete: CASCADE; see deletion policy in README.
  supplier Company @relation("SupplierPart_supplier", fields: [supplier_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Django on_delete: CASCADE; see deletion policy in README.
  manufacturer_part ManufacturerPart? @relation("SupplierPart_manufacturer_part", fields: [manufacturer_part_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fromSupplierPriceBreakPart SupplierPriceBreak[] @relation("SupplierPriceBreak_part")
  fromPurchaseOrderLineItemPart PurchaseOrderLineItem[] @relation("PurchaseOrderLineItem_part")
  fromStockItemSupplier_part StockItem[] @relation("StockItem_supplier_part")
  @@unique([part_id, supplier_id, SKU])
  @@index([manufacturer_part_id])
  @@index([part_id])
  @@index([supplier_id])
  @@map("part_supplierpart")
}

/// Represents a quantity price break for a SupplierPart.
/// Source: src/backend/InvenTree/company/models.py:1002
model SupplierPriceBreak {
  /// DEFAULT_AUTO_FIELD = django.db.models.AutoField
  id Int @id @default(autoincrement())
  updated DateTime? @db.Timestamptz(6)
  /// Source application default: 1
  quantity Decimal @db.Decimal(15, 5)
  price Decimal? @db.Decimal(19, 6)
  part_id Int
  /// django-money companion currency column; default resolved by application settings
  price_currency String? @db.VarChar(3)
  /// Django on_delete: CASCADE; see deletion policy in README.
  part SupplierPart @relation("SupplierPriceBreak_part", fields: [part_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@unique([part_id, quantity])
  @@index([part_id])
  @@map("part_supplierpricebreak")
}
