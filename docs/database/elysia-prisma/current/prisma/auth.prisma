/// Explicit dependency support model; see scope notes.
/// Source: tools/build.py:1
model Permission {
  id Int @id @default(autoincrement())
  name String @db.VarChar(255)
  content_type_id Int
  codename String @db.VarChar(100)
  /// Django on_delete: CASCADE; see deletion policy in README.
  content_type ContentType @relation("Permission_content_type", fields: [content_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fromUserPermissionPermission UserPermission[] @relation("UserPermission_permission")
  fromGroupPermissionPermission GroupPermission[] @relation("GroupPermission_permission")
  @@unique([content_type_id, codename])
  @@index([content_type_id])
  @@map("auth_permission")
}

