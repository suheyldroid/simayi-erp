// Rapor ve etiket şablonları

/// Class representing the ReportTemplate database model.
/// Source: src/backend/InvenTree/report/models.py:362
model ReportTemplate {
  /// DEFAULT_AUTO_FIELD = django.db.models.AutoField
  id Int @id @default(autoincrement())
  updated DateTime? @db.Timestamptz(6)
  updated_by_id Int?
  metadata Json? @db.JsonB
  name String @db.VarChar(100)
  description String @db.VarChar(250)
  /// Source application default: 1
  revision Int
  /// Source application default: False
  attach_to_model Boolean
  /// Source application default: output.pdf
  filename_pattern String @db.VarChar(100)
  /// Source application default: True
  enabled Boolean
  model_type String @db.VarChar(100)
  filters String @db.VarChar(250)
  template String @db.VarChar(100)
  /// Source application default: report.helpers.report_page_size_default
  page_size String @db.VarChar(20)
  /// Source application default: False
  landscape Boolean
  /// Source application default: False
  merge Boolean
  /// Django on_delete: SET_NULL; see deletion policy in README.
  updated_by User? @relation("ReportTemplate_updated_by", fields: [updated_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@unique([name, model_type])
  @@index([updated_by_id])
  @@map("report_reporttemplate")
}

