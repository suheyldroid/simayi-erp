  /// DEFAULT_AUTO_FIELD = django.db.models.AutoField
  id Int @id @default(autoincrement())
  /// Source application default: StockHistoryCode.LEGACY
  trackingType Int @default(0) @map("tracking_type")
  itemId Int? @map("item_id")
  partId Int? @map("part_id")
  date DateTime @default(now()) @db.Timestamptz(6)
  notes String? @db.VarChar(512)
  userId String? @db.Uuid @map("user_id")
  deltas Json? @db.JsonB
  /// Django on_delete: SET_NULL; see deletion policy in README.
  item StockItem? @relation("StockItemTracking_item", fields: [itemId], references: [id], onDelete: SetNull, onUpdate: NoAction)
