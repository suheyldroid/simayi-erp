/// A BuildLine object links a BOMItem to a Build.
/// Source: src/backend/InvenTree/build/models.py:2159
model BuildLine {
  /// DEFAULT_AUTO_FIELD = django.db.models.AutoField
  id Int @id @default(autoincrement())
  buildId Int @map("build_id")
  bomItemId Int @map("bom_item_id")
  /// Source application default: 1
  quantity Decimal @default(1) @db.Decimal(15, 5)
  /// Source application default: 0
  consumed Decimal @default(0) @db.Decimal(15, 5)
  /// Django on_delete: CASCADE; see deletion policy in README.
  build Build @relation("BuildLine_build", fields: [buildId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  /// Django on_delete: CASCADE; see deletion policy in README.
  bomItem BomItem @relation("BuildLine_bomItem", fields: [bomItemId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  fromBuildItemBuildLine BuildItem[] @relation("BuildItem_buildLine")
  @@unique([buildId, bomItemId])
  @@index([bomItemId])
  @@map("build_line")
}

/// A BuildItem links multiple StockItem objects to a Build.
/// Source: src/backend/InvenTree/build/models.py:2279
model BuildItem {
  /// DEFAULT_AUTO_FIELD = django.db.models.AutoField
  id Int @id @default(autoincrement())
  metadata Json? @db.JsonB
  buildLineId Int? @map("build_line_id")
  stockItemId Int @map("stock_item_id")
  /// Source application default: 1
  quantity Decimal @default(1) @db.Decimal(15, 5)
  installIntoId Int? @map("install_into_id")
  /// Django on_delete: CASCADE; see deletion policy in README.
  buildLine BuildLine? @relation("BuildItem_buildLine", fields: [buildLineId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  /// Django on_delete: CASCADE; see deletion policy in README.
  stockItem StockItem @relation("BuildItem_stockItem", fields: [stockItemId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  /// Django on_delete: SET_NULL; see deletion policy in README.
  installInto StockItem? @relation("BuildItem_installInto", fields: [installIntoId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  @@unique([buildLineId, stockItemId, installIntoId])
  @@index([installIntoId])
  @@index([stockItemId])
  @@map("build_item")
}
