// SCIM yapılandırması

/// Simple model for storing config of SCIM.
/// Source: src/backend/InvenTree/scim/models.py:21
model ScimConfiguration {
  /// DEFAULT_AUTO_FIELD = django.db.models.AutoField
  id Int @id @default(autoincrement())
  /// Source application default: False
  enabled Boolean @default(false)
  secretDigest String @default("") @db.VarChar(64) @map("secret_digest")
  secretGenerated DateTime? @db.Timestamptz(6) @map("secret_generated")
  lastUsed DateTime? @db.Timestamptz(6) @map("last_used")
  @@map("scim_configuration")
}
