// İçerik türleri, etiketler ve Django destek tabloları

/// Explicit dependency support model; see scope notes.
/// Source: tools/build.py:1
model ModelType {
  id Int @id @default(autoincrement())
  appLabel String @db.VarChar(100) @map("app_label")
  model String @db.VarChar(100)
  fromNotificationMessageTargetContentType NotificationMessage[] @relation("NotificationMessage_targetContentType")
  fromNotificationMessageSourceContentType NotificationMessage[] @relation("NotificationMessage_sourceContentType")
  fromCustomStatusModel CustomStatus[] @relation("CustomStatus_model")
  fromParameterTemplateModelType ParameterTemplate[] @relation("ParameterTemplate_modelType")
  fromParameterModelType Parameter[] @relation("Parameter_modelType")
  fromNoteModelType Note[] @relation("Note_modelType")
  fromPermissionContentType Permission[] @relation("Permission_contentType")
  fromTaggedItemContentType TaggedItem[] @relation("TaggedItem_contentType")
  @@unique([appLabel, model])
  @@map("model_type")
}

/// Explicit dependency support model; see scope notes.
/// Source: tools/build.py:1
model Tag {
  id Int @id @default(autoincrement())
  name String @unique @db.VarChar(100)
  slug String @unique @db.VarChar(100)
  fromTaggedItemTag TaggedItem[] @relation("TaggedItem_tag")
  @@map("tag")
}

/// Explicit dependency support model; see scope notes.
/// Source: tools/build.py:1
model TaggedItem {
  id Int @id @default(autoincrement())
  tagId Int @map("tag_id")
  contentTypeId Int @map("content_type_id")
  objectId Int @map("object_id")
  /// Django on_delete: CASCADE; see deletion policy in README.
  tag Tag @relation("TaggedItem_tag", fields: [tagId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  /// Django on_delete: CASCADE; see deletion policy in README.
  contentType ModelType @relation("TaggedItem_contentType", fields: [contentTypeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@unique([contentTypeId, objectId, tagId])
  @@index([tagId])
  @@index([objectId])
  @@map("tagged_item")
}
